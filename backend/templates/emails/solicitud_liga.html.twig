<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin: 0; padding: 0; width: 100% !important; font-family: system-ui, -apple-system, sans-serif; background-color: #000000; color: #F8FAFC;">

    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #000000;">
        <tr>
            <td align="center" style="padding: 40px 20px;">

                <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 580px;">

                    <!-- CABECERA -->
                    <tr>
                        <td style="padding-bottom: 24px;">
                            <p style="margin: 0; font-size: 1.1rem; font-weight: 800; color: #ffffff; letter-spacing: -0.02em;">
                                LALIGA MANAGER
                            </p>
                        </td>
                    </tr>

                    <!-- CARD PRINCIPAL -->
                    <tr>
                        <td style="background-color: #141C2F; border-radius: 16px; overflow: hidden; border: 1px solid #1E293B; border-top: 4px solid #007bff;">

                            <table border="0" cellpadding="0" cellspacing="0" width="100%">

                                <!-- TITULO -->
                                <tr>
                                    <td style="padding: 36px 40px 28px 40px; border-bottom: 1px solid #1E293B;">
                                        <p style="margin: 0 0 8px 0; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #3B82F6;">
                                            Nueva solicitud
                                        </p>
                                        <h1 style="margin: 0; font-size: 1.6rem; font-weight: 800; color: #ffffff; letter-spacing: -0.02em;">
                                            Alguien quiere unirse a tu liga
                                        </h1>
                                    </td>
                                </tr>

                                <!-- CUERPO -->
                                <tr>
                                    <td style="padding: 32px 40px;">
                                        <p style="margin: 0 0 24px 0; font-size: 0.95rem; line-height: 1.7; color: #94A3B8;">
                                            Hola <span style="color: #ffffff; font-weight: 600;">{{ nombre_creador }}</span>,
                                            el usuario <span style="color: #ffffff; font-weight: 600;">{{ nombre_solicitante }}</span> ha solicitado unirse a tu liga <span style="color: #ffffff; font-weight: 600;">{{ nombre_liga }}</span>.
                                        </p>

                                        <!-- MENSAJE DEL SOLICITANTE -->
                                        {% if mensaje_solicitante %}
                                        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 32px;">
                                            <tr>
                                                <td style="background-color: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.2); border-left: 3px solid #007bff; border-radius: 8px; padding: 16px 20px;">
                                                    <p style="margin: 0 0 6px 0; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #3B82F6;">
                                                        Mensaje del solicitante
                                                    </p>
                                                    <p style="margin: 0; font-size: 0.95rem; color: #F8FAFC; line-height: 1.6; font-style: italic;">
                                                        "{{ mensaje_solicitante }}"
                                                    </p>
                                                </td>
                                            </tr>
                                        </table>
                                        {% endif %}

                                        <!-- AVISO -->
                                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                            <tr>
                                                <td style="background-color: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 8px; padding: 16px 20px;">
                                                    <p style="margin: 0; font-size: 0.85rem; color: #94A3B8; line-height: 1.6;">
                                                        Accede a <span style="color: #ffffff; font-weight: 600;">LaLiga Manager</span> para aceptar o rechazar la solicitud desde el panel de tu liga.
                                                    </p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- FOOTER -->
                                <tr>
                                    <td style="padding: 20px 40px; border-top: 1px solid #1E293B;">
                                        <p style="margin: 0; font-size: 0.8rem; color: #374151; text-align: center;">
                                            © 2026 LaLiga Manager DAW · Este es un correo automático, por favor no respondas a este mensaje.
                                        </p>
                                    </td>
                                </tr>

                            </table>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>
</html>